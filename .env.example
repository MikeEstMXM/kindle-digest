# ─── Server ───────────────────────────────────────────────────────────────
PORT=3000
APP_BASE_URL=http://localhost:3000

# ─── Storage ──────────────────────────────────────────────────────────────
# SQLite database file. On Fly.io this lives on the mounted volume.
DATABASE_PATH=./data/kindle-digest.sqlite

# ─── SMTP (Send to Kindle) ────────────────────────────────────────────────
# The SMTP "from" address MUST be added to your Amazon Approved Personal
# Document E-mail List, or Kindle will silently reject the delivery.
# For Gmail: use an App Password (requires 2FA), not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# These can also be set in the Settings page (DB overrides env when present).
KINDLE_EMAIL=
DELIVERY_TIME=06:30
TIMEZONE=America/New_York

# ─── Delivery ─────────────────────────────────────────────────────────────
# Where built EPUBs are staged. On Fly this must be on the mounted volume so a
# failed send can be retried without rebuilding the digest.
DIGEST_DIR=./data/digests
# Who gets notified when a digest permanently fails to deliver.
# Defaults to SMTP_FROM. Note this rides the same SMTP path that may be broken.
ALERT_EMAIL=
# Attempts (with exponential backoff) before giving up and alerting.
DELIVERY_MAX_ATTEMPTS=5

# ─── Feed fetching ────────────────────────────────────────────────────────
# Minimum visible-text length (chars) for a feed's own content to be treated
# as "full" before falling back to Readability.js. Tune to your feeds.
FULLTEXT_MIN_CHARS=1800
